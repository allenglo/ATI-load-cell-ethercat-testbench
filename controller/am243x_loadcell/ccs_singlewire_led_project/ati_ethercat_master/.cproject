                              resourcePath="soem_src/ec_foe.c"/>
                    <fileInfo id="com.ti.ccstudio.buildDefinitions.TMS470.Debug.ati_ecat./soem_src/ec_soe.c"
                              name="ec_soe.c" rcbsApplicability="disable"
                              resourcePath="soem_src/ec_soe.c"/>
                    <fileInfo id="com.ti.ccstudio.buildDefinitions.TMS470.Debug.ati_ecat./soem_src/ec_eoe.c"
                              name="ec_eoe.c" rcbsApplicability="disable"
                              resourcePath="soem_src/ec_eoe.c"/>
                    <fileInfo id="com.ti.ccstudio.buildDefinitions.TMS470.Debug.ati_ecat./soem_src/ec_config.c"
                              name="ec_config.c" rcbsApplicability="disable"
