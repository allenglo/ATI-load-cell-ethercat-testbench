<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<?fileVersion 4.0.0?>
<cproject storage_type_id="org.eclipse.cdt.core.XmlProjectDescriptionStorage">
    <storageModule moduleId="org.eclipse.cdt.core.settings">

        <!-- Debug configuration -->
        <cconfiguration id="com.ti.ccstudio.buildDefinitions.TMS470.Debug.ati_ecat">
            <storageModule buildSystemId="org.eclipse.cdt.managedbuilder.core.configurationDataProvider"
                           id="com.ti.ccstudio.buildDefinitions.TMS470.Debug.ati_ecat"
                           moduleId="org.eclipse.cdt.core.settings" name="Debug">
                <macros>
                    <stringMacro name="MCU_PLUS_SDK_PATH" type="VALUE_PATH_ANY" value="${COM_TI_MCU_PLUS_SDK_AM243X_INSTALL_DIR}"/>
                    <stringMacro name="SOEM_PATH"         type="VALUE_PATH_ANY" value="${CCS_PROJECT_DIR}/../../../sdk/soem"/>
                    <stringMacro name="HAL_PATH"          type="VALUE_PATH_ANY" value="${CCS_PROJECT_DIR}"/>
                </macros>
                <externalSettings/>
                <extensions>
                    <extension id="org.eclipse.cdt.core.GmakeErrorParser"              point="com.ti.ccs.project.ErrorParser"/>
                    <extension id="org.eclipse.cdt.core.GASErrorParser"               point="com.ti.ccs.project.ErrorParser"/>
                    <extension id="com.ti.ccs.errorparser.SysConfigErrorParser"        point="com.ti.ccs.project.ErrorParser"/>
                    <extension id="org.eclipse.cdt.core.GCCErrorParser"               point="com.ti.ccs.project.ErrorParser"/>
                    <extension id="com.ti.ccs.errorparser.CompilerErrorParser_TI"      point="com.ti.ccs.project.ErrorParser"/>
                </extensions>
            </storageModule>

            <storageModule moduleId="cdtBuildSystem" version="4.0.0">
                <configuration artifactExtension="out" artifactName="${ProjName}"
                               buildProperties="" cleanCommand="${CG_CLEAN_CMD}"
                               description="ATI EtherCAT Master debug build"
                               id="com.ti.ccstudio.buildDefinitions.TMS470.Debug.ati_ecat"
                               name="Debug"
                               parent="com.ti.ccstudio.buildDefinitions.TMS470.Debug"
                               postbuildStep="$(MAKE) -C ${CCS_PROJECT_DIR} -f makefile_ccs_bootimage_gen OUTNAME=${BuildArtifactFileBaseName} PROFILE=${ConfigName} MCU_PLUS_SDK_PATH=${MCU_PLUS_SDK_PATH} CG_TOOL_ROOT=${CG_TOOL_ROOT} CCS_INSTALL_DIR=${CCS_INSTALL_DIR} CCS_IDE_MODE=${CCS_IDE_MODE} DEVICE=am243x">

                    <folderInfo id="com.ti.ccstudio.buildDefinitions.TMS470.Debug.ati_ecat."
                                name="/" resourcePath="">
                        <toolChain id="com.ti.ccstudio.buildDefinitions.TMS470_TICLANG_4.0.exe.DebugToolchain.ati_ecat"
                                   name="TI Build Tools"
                                   superClass="com.ti.ccstudio.buildDefinitions.TMS470_TICLANG_4.0.exe.DebugToolchain"
                                   targetTool="com.ti.ccstudio.buildDefinitions.TMS470_TICLANG_4.0.exe.linkerDebug.ati_ecat">

                            <option id="com.ti.ccstudio.buildDefinitions.core.OPT_TAGS.ati_ecat_dbg"
                                    superClass="com.ti.ccstudio.buildDefinitions.core.OPT_TAGS"
                                    valueType="stringList">
                                <listOptionValue value="DEVICE_CONFIGURATION_ID=Cortex R.AM2434_ALX"/>
                                <listOptionValue value="DEVICE_CORE_ID=MAIN_PULSAR_Cortex_R5_0_0"/>
                                <listOptionValue value="DEVICE_ENDIANNESS=little"/>
                                <listOptionValue value="OUTPUT_FORMAT=ELF"/>
                                <listOptionValue value="OUTPUT_TYPE=executable"/>
                                <listOptionValue value="PRODUCTS=sysconfig:1.20.0;com.ti.MCU_PLUS_SDK_AM243X:12.0.0.26;"/>
                                <listOptionValue value="PRODUCT_MACRO_IMPORTS={&quot;sysconfig&quot;:[&quot;${SYSCONFIG_TOOL_INCLUDE_PATH}&quot;,&quot;${SYSCONFIG_TOOL_LIBRARY_PATH}&quot;,&quot;${SYSCONFIG_TOOL_LIBRARIES}&quot;,&quot;${SYSCONFIG_TOOL_SYMBOLS}&quot;,&quot;${SYSCONFIG_TOOL_SYSCONFIG_MANIFEST}&quot;],&quot;com.ti.MCU_PLUS_SDK_AM243X&quot;:[&quot;${COM_TI_MCU_PLUS_SDK_AM243X_INCLUDE_PATH}&quot;,&quot;${COM_TI_MCU_PLUS_SDK_AM243X_LIBRARY_PATH}&quot;,&quot;${COM_TI_MCU_PLUS_SDK_AM243X_LIBRARIES}&quot;,&quot;${COM_TI_MCU_PLUS_SDK_AM243X_SYMBOLS}&quot;,&quot;${COM_TI_MCU_PLUS_SDK_AM243X_SYSCONFIG_MANIFEST}&quot;]}"/>
                            </option>
                            <option id="com.ti.ccstudio.buildDefinitions.core.OPT_CODEGEN_VERSION.ati_ecat_dbg"
                                    superClass="com.ti.ccstudio.buildDefinitions.core.OPT_CODEGEN_VERSION"
                                    value="TICLANG_4.0.1.LTS" valueType="string"/>

                            <targetPlatform id="com.ti.ccstudio.buildDefinitions.TMS470_TICLANG_4.0.exe.targetPlatformDebug.ati_ecat"
                                            name="Platform"
                                            superClass="com.ti.ccstudio.buildDefinitions.TMS470_TICLANG_4.0.exe.targetPlatformDebug"/>

                            <builder buildPath="${BuildDirectory}"
                                     id="com.ti.ccstudio.buildDefinitions.TMS470_TICLANG_4.0.exe.builderDebug.ati_ecat"
                                     name="GNU Make.Debug"
                                     parallelBuildOn="true" parallelizationNumber="optimal"
                                     superClass="com.ti.ccstudio.buildDefinitions.TMS470_TICLANG_4.0.exe.builderDebug"/>

                            <!-- Compiler -->
                            <tool id="com.ti.ccstudio.buildDefinitions.TMS470_TICLANG_4.0.exe.compilerDebug.ati_ecat"
                                  name="Arm Compiler"
                                  superClass="com.ti.ccstudio.buildDefinitions.TMS470_TICLANG_4.0.exe.compilerDebug">
                                <option id="com.ti.ccstudio.buildDefinitions.TMS470_TICLANG_4.0.compilerID.GENERATE_DWARF_DEBUG.ati_ecat"
                                        superClass="com.ti.ccstudio.buildDefinitions.TMS470_TICLANG_4.0.compilerID.GENERATE_DWARF_DEBUG"
                                        value="com.ti.ccstudio.buildDefinitions.TMS470_TICLANG_4.0.compilerID.GENERATE_DWARF_DEBUG.G_LOWERCASE"
                                        valueType="enumerated"/>
                                <option id="com.ti.ccstudio.buildDefinitions.TMS470_TICLANG_4.0.compilerID.ENDIAN_NESS__BIG_LITTLE.ati_ecat"
                                        superClass="com.ti.ccstudio.buildDefinitions.TMS470_TICLANG_4.0.compilerID.ENDIAN_NESS__BIG_LITTLE"
                                        value="com.ti.ccstudio.buildDefinitions.TMS470_TICLANG_4.0.compilerID.ENDIAN_NESS__BIG_LITTLE.MLITTLE_ENDIAN"
                                        valueType="enumerated"/>
                                <option id="com.ti.ccstudio.buildDefinitions.TMS470_TICLANG_4.0.compilerID.MCPU.ati_ecat"
                                        superClass="com.ti.ccstudio.buildDefinitions.TMS470_TICLANG_4.0.compilerID.MCPU"
                                        value="com.ti.ccstudio.buildDefinitions.TMS470_TICLANG_4.0.compilerID.MCPU.cortex-r5"
                                        valueType="enumerated"/>
                                <option id="com.ti.ccstudio.buildDefinitions.TMS470_TICLANG_4.0.compilerID.MFLOAT_ABI.ati_ecat"
                                        superClass="com.ti.ccstudio.buildDefinitions.TMS470_TICLANG_4.0.compilerID.MFLOAT_ABI"
                                        value="com.ti.ccstudio.buildDefinitions.TMS470_TICLANG_4.0.compilerID.MFLOAT_ABI.hard"
                                        valueType="enumerated"/>
                                <option id="com.ti.ccstudio.buildDefinitions.TMS470_TICLANG_4.0.compilerID.MFPU.ati_ecat"
                                        superClass="com.ti.ccstudio.buildDefinitions.TMS470_TICLANG_4.0.compilerID.MFPU"
                                        value="com.ti.ccstudio.buildDefinitions.TMS470_TICLANG_4.0.compilerID.MFPU.vfpv3-d16"
                                        valueType="enumerated"/>
                                <option id="com.ti.ccstudio.buildDefinitions.TMS470_TICLANG_4.0.compilerID.SELECT_PROCESSOR_MODE__ARM_THUMB.ati_ecat"
                                        superClass="com.ti.ccstudio.buildDefinitions.TMS470_TICLANG_4.0.compilerID.SELECT_PROCESSOR_MODE__ARM_THUMB"
                                        value="com.ti.ccstudio.buildDefinitions.TMS470_TICLANG_4.0.compilerID.SELECT_PROCESSOR_MODE__ARM_THUMB.MTHUMB"
                                        valueType="enumerated"/>
                                <option id="com.ti.ccstudio.buildDefinitions.TMS470_TICLANG_4.0.compilerID.INCLUDE_PATH.ati_ecat"
                                        superClass="com.ti.ccstudio.buildDefinitions.TMS470_TICLANG_4.0.compilerID.INCLUDE_PATH"
                                        valueType="includePath">
                                    <!-- SysConfig generated -->
                                    <listOptionValue value="${SYSCONFIG_TOOL_INCLUDE_PATH}"/>
                                    <listOptionValue value="${COM_TI_MCU_PLUS_SDK_AM243X_INCLUDE_PATH}"/>
                                    <listOptionValue value="${CG_TOOL_ROOT}/include/c"/>
                                    <!-- MCU+ SDK -->
                                    <listOptionValue value="${MCU_PLUS_SDK_PATH}/source"/>
                                    <listOptionValue value="${MCU_PLUS_SDK_PATH}/source/board/ethphy/enet/rtos_drivers/include"/>
                                    <listOptionValue value="${MCU_PLUS_SDK_PATH}/source/board/ethphy/port"/>
                                    <listOptionValue value="${MCU_PLUS_SDK_PATH}/source/kernel/freertos/FreeRTOS-Kernel/include"/>
                                    <listOptionValue value="${MCU_PLUS_SDK_PATH}/source/kernel/freertos/portable/TI_ARM_CLANG/ARM_CR5F"/>
                                    <listOptionValue value="${MCU_PLUS_SDK_PATH}/source/kernel/freertos/config/am243x/r5f"/>
                                    <listOptionValue value="${MCU_PLUS_SDK_PATH}/source/networking/enet"/>
                                    <listOptionValue value="${MCU_PLUS_SDK_PATH}/source/networking/enet/core/utils"/>
                                    <listOptionValue value="${MCU_PLUS_SDK_PATH}/source/networking/enet/core/utils/include"/>
                                    <listOptionValue value="${MCU_PLUS_SDK_PATH}/source/networking/enet/core/utils/V3"/>
                                    <listOptionValue value="${MCU_PLUS_SDK_PATH}/source/networking/enet/core"/>
                                    <listOptionValue value="${MCU_PLUS_SDK_PATH}/source/networking/enet/core/include"/>
                                    <listOptionValue value="${MCU_PLUS_SDK_PATH}/source/networking/enet/core/include/phy"/>
                                    <listOptionValue value="${MCU_PLUS_SDK_PATH}/source/networking/enet/core/include/core"/>
                                    <listOptionValue value="${MCU_PLUS_SDK_PATH}/source/networking/enet/hw_include"/>
                                    <listOptionValue value="${MCU_PLUS_SDK_PATH}/source/networking/enet/soc/k3/am64x_am243x"/>
                                    <listOptionValue value="${MCU_PLUS_SDK_PATH}/source/networking/enet/hw_include/mdio/V4"/>
                                    <!-- SOEM -->
                                    <listOptionValue value="${SOEM_PATH}/include"/>
                                    <listOptionValue value="${SOEM_PATH}/osal"/>
                                    <!-- HAL port -->
                                    <listOptionValue value="${HAL_PATH}/osal/freertos"/>
                                    <listOptionValue value="${HAL_PATH}/oshw/am243x"/>
                                </option>
                                <option id="com.ti.ccstudio.buildDefinitions.TMS470_TICLANG_4.0.compilerID.DEFINE.ati_ecat"
                                        superClass="com.ti.ccstudio.buildDefinitions.TMS470_TICLANG_4.0.compilerID.DEFINE"
                                        valueType="definedSymbols">
                                    <listOptionValue value="${SYSCONFIG_TOOL_SYMBOLS}"/>
                                    <listOptionValue value="${COM_TI_MCU_PLUS_SDK_AM243X_SYMBOLS}"/>
                                    <listOptionValue value="SOC_AM243X"/>
                                    <listOptionValue value="OS_FREERTOS"/>
                                    <listOptionValue value="_DEBUG_=1"/>
                                </option>
                                <option id="com.ti.ccstudio.buildDefinitions.TMS470_TICLANG_4.0.compilerID.WALL.ati_ecat"
                                        superClass="com.ti.ccstudio.buildDefinitions.TMS470_TICLANG_4.0.compilerID.WALL"
                                        value="true" valueType="boolean"/>
                                <option id="com.ti.ccstudio.buildDefinitions.TMS470_TICLANG_4.0.compilerID.WNO.ati_ecat_"
                                        superClass="com.ti.ccstudio.buildDefinitions.TMS470_TICLANG_4.0.compilerID.WNO_"
                                        valueType="stringList">
                                    <listOptionValue value="gnu-variable-sized-type-not-at-end"/>
                                    <listOptionValue value="unused-function"/>
                                    <listOptionValue value="unused-variable"/>
                                </option>
                            </tool>

                            <!-- Linker -->
                            <tool id="com.ti.ccstudio.buildDefinitions.TMS470_TICLANG_4.0.exe.linkerDebug.ati_ecat"
                                  name="Arm Linker"
                                  superClass="com.ti.ccstudio.buildDefinitions.TMS470_TICLANG_4.0.exe.linkerDebug">
                                <option id="com.ti.ccstudio.buildDefinitions.TMS470_TICLANG_4.0.linkerID.OUTPUT_FILE.ati_ecat"
                                        superClass="com.ti.ccstudio.buildDefinitions.TMS470_TICLANG_4.0.linkerID.OUTPUT_FILE"
                                        value="${ProjName}.out" valueType="string"/>
                                <option id="com.ti.ccstudio.buildDefinitions.TMS470_TICLANG_4.0.linkerID.MAP_FILE.ati_ecat"
                                        superClass="com.ti.ccstudio.buildDefinitions.TMS470_TICLANG_4.0.linkerID.MAP_FILE"
                                        value="${ProjName}.${ConfigName}.map" valueType="string"/>
                                <option id="com.ti.ccstudio.buildDefinitions.TMS470_TICLANG_4.0.linkerID.DISPLAY_ERROR_NUMBER.ati_ecat"
                                        superClass="com.ti.ccstudio.buildDefinitions.TMS470_TICLANG_4.0.linkerID.DISPLAY_ERROR_NUMBER"
                                        value="true" valueType="boolean"/>
                                <option id="com.ti.ccstudio.buildDefinitions.TMS470_TICLANG_4.0.linkerID.DIAG_WRAP.ati_ecat"
                                        superClass="com.ti.ccstudio.buildDefinitions.TMS470_TICLANG_4.0.linkerID.DIAG_WRAP"
                                        value="com.ti.ccstudio.buildDefinitions.TMS470_TICLANG_4.0.linkerID.DIAG_WRAP.off"
                                        valueType="enumerated"/>
                                <option id="com.ti.ccstudio.buildDefinitions.TMS470_TICLANG_4.0.linkerID.REREAD_LIBS.ati_ecat"
                                        superClass="com.ti.ccstudio.buildDefinitions.TMS470_TICLANG_4.0.linkerID.REREAD_LIBS"
                                        value="true" valueType="boolean"/>
                                <option id="com.ti.ccstudio.buildDefinitions.TMS470_TICLANG_4.0.linkerID.INITIALIZATION_MODEL.ati_ecat"
                                        superClass="com.ti.ccstudio.buildDefinitions.TMS470_TICLANG_4.0.linkerID.INITIALIZATION_MODEL"
                                        value="com.ti.ccstudio.buildDefinitions.TMS470_TICLANG_4.0.linkerID.INITIALIZATION_MODEL.RAM_MODEL"
                                        valueType="enumerated"/>
                                <option id="com.ti.ccstudio.buildDefinitions.TMS470_TICLANG_4.0.linkerID.SEARCH_PATH.ati_ecat"
                                        superClass="com.ti.ccstudio.buildDefinitions.TMS470_TICLANG_4.0.linkerID.SEARCH_PATH"
                                        valueType="libPaths">
                                    <listOptionValue value="${SYSCONFIG_TOOL_LIBRARY_PATH}"/>
                                    <listOptionValue value="${COM_TI_MCU_PLUS_SDK_AM243X_LIBRARY_PATH}"/>
                                    <listOptionValue value="${MCU_PLUS_SDK_PATH}/source/kernel/freertos/lib"/>
                                    <listOptionValue value="${MCU_PLUS_SDK_PATH}/source/drivers/lib"/>
                                    <listOptionValue value="${MCU_PLUS_SDK_PATH}/source/board/lib"/>
                                    <listOptionValue value="${MCU_PLUS_SDK_PATH}/source/networking/enet/lib"/>
                                    <listOptionValue value="${CG_TOOL_ROOT}/lib"/>
                                </option>
                                <option id="com.ti.ccstudio.buildDefinitions.TMS470_TICLANG_4.0.linkerID.LIBRARY.ati_ecat"
                                        superClass="com.ti.ccstudio.buildDefinitions.TMS470_TICLANG_4.0.linkerID.LIBRARY"
                                        valueType="libs">
                                    <listOptionValue value="${SYSCONFIG_TOOL_LIBRARIES}"/>
                                    <listOptionValue value="${COM_TI_MCU_PLUS_SDK_AM243X_LIBRARIES}"/>
                                    <listOptionValue value="freertos.am243x.r5f.ti-arm-clang.debug.lib"/>
                                    <listOptionValue value="drivers.am243x.r5f.ti-arm-clang.freertos.debug.lib"/>
                                    <listOptionValue value="enet-cpsw.am243x.r5f.ti-arm-clang.freertos.debug.lib"/>
                                    <listOptionValue value="board.am243x.r5f.ti-arm-clang.freertos.debug.lib"/>
                                    <listOptionValue value="libc.a"/>
                                    <listOptionValue value="libsysbm.a"/>
                                </option>
                                <option id="com.ti.ccstudio.buildDefinitions.TMS470_TICLANG_4.0.linkerID.DIAG_SUPPRESS.ati_ecat"
                                        superClass="com.ti.ccstudio.buildDefinitions.TMS470_TICLANG_4.0.linkerID.DIAG_SUPPRESS"
                                        valueType="stringList">
                                    <listOptionValue value="10063"/>
                                </option>
                            </tool>

                            <!-- SysConfig -->
                            <tool id="com.ti.ccstudio.buildDefinitions.sysConfig.ati_ecat_dbg"
                                  name="SysConfig"
                                  superClass="com.ti.ccstudio.buildDefinitions.sysConfig">
                                <option id="com.ti.ccstudio.buildDefinitions.sysConfig.PRODUCTS.ati_ecat_dbg"
                                        superClass="com.ti.ccstudio.buildDefinitions.sysConfig.PRODUCTS"
                                        valueType="stringList">
                                    <listOptionValue value="${SYSCONFIG_TOOL_SYSCONFIG_MANIFEST}"/>
                                    <listOptionValue value="${COM_TI_MCU_PLUS_SDK_AM243X_SYSCONFIG_MANIFEST}"/>
                                </option>
                                <option id="com.ti.ccstudio.buildDefinitions.sysConfig.CONTEXT.ati_ecat_dbg"
                                        superClass="com.ti.ccstudio.buildDefinitions.sysConfig.CONTEXT"
                                        value="r5fss0-0" valueType="string"/>
                                <option id="com.ti.ccstudio.buildDefinitions.sysConfig.PART.ati_ecat_dbg"
                                        superClass="com.ti.ccstudio.buildDefinitions.sysConfig.PART"
                                        value="ALX" valueType="string"/>
                                <option id="com.ti.ccstudio.buildDefinitions.sysConfig.PACKAGE.ati_ecat_dbg"
                                        superClass="com.ti.ccstudio.buildDefinitions.sysConfig.PACKAGE"
                                        value="ALX" valueType="string"/>
                            </tool>

                        </toolChain>
                    </folderInfo>

                    <!-- Source files to compile -->
                    <fileInfo id="com.ti.ccstudio.buildDefinitions.TMS470.Debug.ati_ecat./app/ati_ecat_master.c"
                              name="ati_ecat_master.c" rcbsApplicability="disable"
                              resourcePath="app/ati_ecat_master.c"/>
                    <fileInfo id="com.ti.ccstudio.buildDefinitions.TMS470.Debug.ati_ecat./osal/freertos/osal.c"
