                              resourcePath="soem_src/ec_print.c"/>

                </configuration>
            </storageModule>
            <storageModule moduleId="org.eclipse.cdt.core.externalSettings"/>
        </cconfiguration>

    </storageModule>

    <storageModule moduleId="cdtBuildSystem" version="4.0.0">
        <project id="ati_ethercat_master.com.ti.ccstudio.buildDefinitions.TMS470.1" name="TMS470" projectType="com.ti.ccstudio.buildDefinitions.TMS470.exe"/>
