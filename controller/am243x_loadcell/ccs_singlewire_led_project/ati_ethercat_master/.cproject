                    <fileInfo id="com.ti.ccstudio.buildDefinitions.TMS470.Debug.ati_ecat./oshw/am243x/nicdrv.c"
                              name="nicdrv.c" rcbsApplicability="disable"
                              resourcePath="oshw/am243x/nicdrv.c"/>
                    <fileInfo id="com.ti.ccstudio.buildDefinitions.TMS470.Debug.ati_ecat./oshw/am243x/oshw.c"
                              name="oshw.c" rcbsApplicability="disable"
                              resourcePath="oshw/am243x/oshw.c"/>
                    <!-- SOEM core source files (linked via soem_src virtual folder) -->
                    <fileInfo id="com.ti.ccstudio.buildDefinitions.TMS470.Debug.ati_ecat./soem_src/ec_base.c"
                              name="ec_base.c" rcbsApplicability="disable"
